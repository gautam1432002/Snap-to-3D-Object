# ============================================================
# Foldly — .gitignore
# ============================================================

# ── Secrets ─────────────────────────────────────────────────
.env
.env.*
*.env
!*.env.example

# ── Python (backend) ─────────────────────────────────────────
venv/
.venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/
*.egg
*.whl
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
coverage.xml

# ── Node / React Native Expo (mobile) ────────────────────────
node_modules/
.pnp
.pnp.js

# Expo / React Native build artefacts
.expo/
.expo-shared/
android/
ios/
*.apk
*.aab
*.ipa
*.jks
*.keystore
*.p8
*.p12
*.mobileprovision

# Metro bundler cache
.metro-health-check*

# ── Build output ─────────────────────────────────────────────
dist/
build/
out/
*.tgz

# ── Databases / local storage ────────────────────────────────
*.sqlite
*.sqlite3
*.db
backend/storage/*
!backend/storage/.gitkeep

# ── Logs ─────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS / Editor noise ────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~

# ── Miscellaneous ─────────────────────────────────────────────
*.tmp
*.bak
